{
  "manifest_version": 3,
  "name": "LinkedIn Network Sync",
  "version": "1.5.0",
  "description": "Reads your own LinkedIn connections, messages and posts, with your own session, and hands them to the LinkedIn Network tool.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "alarms", "unlimitedStorage", "webRequest"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "LinkedIn Network Sync", "default_popup": "popup.html" },
  "externally_connectable": { "matches": [] }
}
